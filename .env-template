# ElasticSearch credentials
ELASTICSEARCH_HOST=<url_of_the_elasticsearch_instance>
ELASTICSEARCH_USERNAME=<username_for_es_instance>
ELASTICSEARCH_PASSWORD=<password_for_es_instance>
ELASTICSEARCH_PORT=<9200>
ELASTICSEARCH_PROTOCOL=https
ELASTICSEARCH_INDEX=<set to override - defaults to latest complete collection index>

# NetX configuration
NETX_API_TOKEN=<api_token_from_netx>
REACT_APP_NETX_BASE_URL=<url_for_netx_instance>
REACT_APP_NETX_ENABLED=false

# V2 collection store (Postgres) — source for carousel renditions (CS-55; replaces the live NetX rendition fetch).
# Read-only; the site never writes. Point at the shared V2 collection DB (no local copy needed).
PG_HOST=<host_of_the_v2_collection_postgres_or_rds_proxy>
PG_PORT=<5432>
PG_USER=<read_only_db_user>
PG_PASSWORD=<db_password; leave blank when PG_IAM_AUTH=true>
PG_DATABASE=<database_name; defaults to postgres>
PG_SCHEMA=<schema; defaults to collection>
PG_IAM_AUTH=<true to auth to RDS via a short-lived IAM token instead of a password; defaults to false>

# AWS Credentials and configuration
AWS_BUCKET=<s3_bucket_for_all_images>
AWS_REGION=<region_for_s3_bucket>
AWS_ACCESS_KEY=<aws_access_key>
AWS_SECRET_KEY=<aws_secret_access_key>

# Wufoo forms credentials
WUFOO_SUBDOMAIN=
WUFOO_USERNAME=
WUFOO_PASSWORD=
WUFOO_DOWNLOAD_FORM=

# React variables injected during build time.
REACT_APP_AWS_BUCKET=<same_as_aws_bucket>
REACT_APP_IMAGES_PREFIX=<directory_for_images_within_bucket>
REACT_APP_PRINTS_ENDPOINT=<url_for_json_map_from_accession_number_to_print_url>
REACT_APP_IMAGE_BASE_URL=<url_for_images>

# Legacy Universal Analytics id. Nothing reads it since CS-84 (UA is retired); GA4 below replaces it.
REACT_APP_GOOGLE_ANALYTICS_ID=<UA-xxxxxxxx-xx>

# Analytics (CS-84, see ANALYTICS.md). Events only send when the measurement id is set AND the page's
# host equals REACT_APP_ANALYTICS_HOST, so local and dev builds stay silent with these blank.
REACT_APP_GA4_MEASUREMENT_ID=<G-xxxxxxxxxx; GA4 web stream id; leave blank to turn GA4 off>
REACT_APP_HOTJAR_ID=<hotjar site id; leave blank to turn Hotjar off>
REACT_APP_ANALYTICS_HOST=<hostname analytics may run on; defaults to collection.barnesfoundation.org>
REACT_APP_BUILD_ID=<release tag + short sha, e.g. v2.0.4+1a2b3c4, sent as the build_id user property; CI sets it; defaults to local>

# Server-side GA4 file_download event via the Measurement Protocol (server/analytics.js). Off unless both are set.
GA4_MEASUREMENT_ID=<G-xxxxxxxxxx; same id as REACT_APP_GA4_MEASUREMENT_ID>
GA4_API_SECRET=<Measurement Protocol API secret from GA4 Admin → Data stream; in Secrets Manager on AWS>
BUILD_ID=<same value as REACT_APP_BUILD_ID, for server events; CI sets it; defaults to local>

REACT_APP_CANONICAL_ROOT=https://collection.barnesfoundation.org
REACT_APP_NEWSLETTER_URL=<Post endpoint for subscription>

NODE_ENV=<production>